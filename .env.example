# Template for the real `.env`. Copy this file to `.env` and fill in your own
# credentials. `.env` is gitignored so real secrets never enter git history.
#
# Rotate any key that has ever been committed, logged, or shared.

# ── Exchange credentials ──
MEXC_API_KEY=
MEXC_API_SECRET=

# Bybit main (production) — only used by scripts that need to create demo
# sub-accounts. Keep minimal permissions (read + subaccount management).
BYBIT_MAIN_API_KEY=
BYBIT_MAIN_API_SECRET=

# Bybit demo (paper trading) — day-to-day runtime credentials
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Binance (used for historical-data downloads + live VPIN WS feed)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Deribit (options data + paper trades)
DERIBIT_API_KEY=
DERIBIT_API_SECRET=

# Hyperliquid (live vault)
HL_ADDRESS=
HL_PRIVATE_KEY=

# ── Messaging / alerts ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Data vendors ──
COINGLASS_API_KEY=
QUANTCONNECT_USER_ID=
QUANTCONNECT_API_TOKEN=
KAGGLE_USERNAME=
KAGGLE_KEY=

# ── GitHub / deployment ──
GITHUB_TOKEN=
